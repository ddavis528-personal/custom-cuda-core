        "rtl/ooe/ooe_confirm.sv"
      ],
      "params": {
        "N": 45,
        "LAT_SPEC": 14,
        "LAT_MISS": 17
      },
      "clock": "ooe_core_clk",
      "reset": "ooe_rst_r00h",
      "bench": {
        "build": "test/ooe/cg-build.sh ooe_wake {dir}",
